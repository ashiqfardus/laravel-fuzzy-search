{
    "name": "ashiqfardus/laravel-fuzzy-search",
    "description": "A powerful, zero-config fuzzy search package for Laravel with fluent API",
    "keywords": ["laravel", "fuzzy", "search", "eloquent", "query-builder", "levenshtein", "soundex", "trigram", "typo-tolerance", "bm25", "inverted-index"],
    "license": "MIT",
    "authors": [
        {
            "name": "Md Asikul Islam",
            "email": "ashiqfardus@hotmail.com"
        }
    ],
    "require": {
        "php": "^8.1|^8.2|^8.3|^8.4|^8.5",
        "illuminate/database": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/http": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/console": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/queue": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/bus": "^10.0|^11.0|^12.0|^13.0",
        "symfony/finder": "^6.0|^7.0|^8.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^10.0|^11.0|^12.0|^13.0",
        "wamania/php-stemmer": "^1.2",
        "laravel/scout": "^10.0|^11.0",
        "filament/filament": "^3.3"
    },
    "suggest": {
        "laravel/scout": "Required for Scout driver integration (^10.0|^11.0)",
        "filament/filament": "Required for the HasFuzzyGlobalSearch trait and tableSearch() (v3.3+)",
        "wamania/php-stemmer": "Required for language stemming support (^1.2)",
        "ext-intl": "Unicode decomposition for indexing.accent_insensitive and accentInsensitive() (the built-in map is the fallback)"
    },
    "autoload": {
        "psr-4": {
            "Ashiqfardus\\LaravelFuzzySearch\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Ashiqfardus\\LaravelFuzzySearch\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "test-coverage": "vendor/bin/phpunit --coverage-html coverage",
        "benchmark": "vendor/bin/phpunit --testsuite Performance"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Ashiqfardus\\LaravelFuzzySearch\\FuzzySearchServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
